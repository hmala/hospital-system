@echo off
title نظام إدارة المستشفى - Hospital Management System
color 0b
chcp 65001 >nul

echo ======================================================================
echo           🏥  نظام إدارة المستشفى المتكامل - Hospital System
echo ======================================================================
echo.

:: الانتقال التلقائي لمجلد المشروع
cd /d "%~dp0"
echo [*] مجلد النظام: %cd%

:: فحص PHP
where php >nul 2>&1
if %ERRORLEVEL% NEQ 0 (
    echo [!] تحذير: لم يتم العثور على أمر PHP في المسار العام (PATH).
    echo يرجى التأكد من تشغيل WampServer أو Laragon أو تثبيت PHP.
    pause
    exit /b
)

:: فتح المتصفح تلقائياً بعد ثانيتين فور بدء الخادم
echo [*] جاري تجهيز المتصفح لفتح النظام...
start /b "" cmd /c "ping 127.0.0.1 -n 3 >nul && start http://127.0.0.1:8000"

echo [*] جاري تشغيل خادم النظام (Artisan Server)...
echo.
echo ======================================================================
echo  الرابط المباشر: http://127.0.0.1:8000
echo  ملاحظة: اترك هذه النافذة مفتوحة طوال فترة العمل على النظام.
echo  للإيقاف: اضغط Ctrl + C أو أغلق هذه النافذة.
echo ======================================================================
echo.

php artisan serve --host=127.0.0.1 --port=8000

pause
